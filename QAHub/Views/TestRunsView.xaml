<UserControl x:Class="QAHub.Views.TestRunsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="RunCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StatusPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
        <Grid>

            <!-- ============ LIST VIEW ============ -->
            <StackPanel Visibility="{Binding IsListView, Converter={StaticResource BoolToVisConverter}}">

                <TextBlock Text="Test Runs" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Execute test cases against a build and track results"
                           Foreground="#6B7280" Margin="0,3,0,22"/>

                <UniformGrid Columns="4" Margin="0,0,-12,18">
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalRuns}" FontSize="34" FontWeight="Bold"/>
                            <TextBlock Text="TOTAL RUNS" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding InProgressRuns}" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="IN PROGRESS" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding CompletedRuns}" FontSize="34" FontWeight="Bold"
                                       Foreground="#22C55E"/>
                            <TextBlock Text="COMPLETED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding OverallPassRateLabel}" FontSize="34" FontWeight="Bold"/>
                            <TextBlock Text="OVERALL PASS RATE" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- New run form -->
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="New Test Run" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Padding="8,6"
                                     Text="{Binding NewRunName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Run name (e.g. Release 2.4 Regression)"/>
                            <TextBox Grid.Column="2" Padding="8,6"
                                     Text="{Binding NewRunBuildVersion, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Build/version (optional)"/>
                            <Button Grid.Column="4" Content="Create Run"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding CreateRunCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Run list -->
                <ItemsControl ItemsSource="{Binding Runs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RunCardStyle}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenRunCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,2,0,0">
                                            <Run Text="{Binding BuildVersion, TargetNullValue='No build set'}"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding ExecutedCount, Mode=OneWay}"/>
                                            <Run Text="/"/>
                                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                                            <Run Text=" executed"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,16,0"/>

                                    <TextBlock Grid.Column="2" Text="{Binding PassRatePercent, StringFormat={}{0}%}"
                                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No test runs yet. Create one above to get started."
                           Foreground="#6B7280" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalRuns}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- ============ DETAIL VIEW ============ -->
            <StackPanel Visibility="{Binding IsDetailView, Converter={StaticResource BoolToVisConverter}}">

                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Button Content="&#8592; Back to Test Runs" Command="{Binding BackToListCommand}"
                                HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource AccentBrush}" Cursor="Hand" Padding="0"
                                Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SelectedRun.Name}" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Foreground="#6B7280" Margin="0,3,0,0">
                            <Run Text="{Binding SelectedRun.BuildVersion, TargetNullValue='No build set'}"/>
                            <Run Text=" • "/>
                            <Run Text="{Binding SelectedRun.Status, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Complete Run" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CompleteRunCommand}" VerticalAlignment="Top" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="Delete Run" Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DeleteRunCommand}" CommandParameter="{Binding SelectedRun}"
                            VerticalAlignment="Top"/>
                </Grid>

                <UniformGrid Columns="4" Margin="0,0,-12,18">
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRun.TotalCount}" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="TOTAL CASES" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRun.PassedCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="#22C55E"/>
                            <TextBlock Text="PASSED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRun.FailedCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text="FAILED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRun.BlockedCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="#D97706"/>
                            <TextBlock Text="BLOCKED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Add test case (placeholder until wired to real TestCases list) -->
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Add Test Case to Run" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Temporary: type a case name directly. This should later pick from your real Test Cases list."
                                   FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Padding="8,6"
                                     Text="{Binding NewItemCaseName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="Add" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddItemCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Items in this run -->
                <ItemsControl ItemsSource="{Binding SelectedRun.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CaseName}"
                                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Pass" Style="{StaticResource StatusPillButtonStyle}"
                                                Command="{Binding DataContext.MarkPassedCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Fail" Style="{StaticResource StatusPillButtonStyle}"
                                                Background="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.MarkFailedCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Blocked" Style="{StaticResource StatusPillButtonStyle}"
                                                Background="#D97706"
                                                Command="{Binding DataContext.MarkBlockedCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Skip" Style="{StaticResource StatusPillButtonStyle}"
                                                Background="#6B7280"
                                                Command="{Binding DataContext.MarkSkippedCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Report Bug" Style="{StaticResource StatusPillButtonStyle}"
                                                Background="#111827"
                                                Command="{Binding DataContext.ReportBugCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Remove" Style="{StaticResource StatusPillButtonStyle}"
                                                Background="Transparent" Foreground="#6B7280"
                                                Command="{Binding DataContext.RemoveItemCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
