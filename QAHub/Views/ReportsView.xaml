<UserControl x:Class="QAHub.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
        <StackPanel>

            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Reports" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Pass rate trends and requirement coverage, drawn from Test Runs and Requirements"
                               Foreground="#6B7280" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Top" Command="{Binding RefreshCommand}"/>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,-12,22">
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalRuns}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="TEST RUNS" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalExecutedCases}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="CASES EXECUTED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding OverallPassRateLabel}" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="OVERALL PASS RATE" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="30" FontWeight="Bold" Foreground="#22C55E">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}/{1}">
                                    <Binding Path="FullyTestedCount"/>
                                    <Binding Path="TotalRequirements"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="REQUIREMENTS FULLY TESTED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Pass rate by run -->
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Pass Rate by Run" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <ItemsControl ItemsSource="{Binding RunRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ProgressLabel}" FontSize="11" Foreground="#6B7280"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#E5E7EB" CornerRadius="4" Height="14"
                                            VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <Border CornerRadius="4" Height="14" HorizontalAlignment="Left"
                                                Background="{StaticResource AccentBrush}"
                                                Width="{Binding PassRatePercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=400}"/>
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding PassRatePercent, StringFormat={}{0}%}"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No test runs yet — create one on the Test Runs page to see pass rate data here."
                               Foreground="#6B7280">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalRuns}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Requirement coverage -->
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Requirement Coverage" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <Border Background="#E5E7EB" CornerRadius="4" Height="18" Margin="0,0,0,12">
                        <Grid HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="4,0,0,4" Height="18" Background="#22C55E"
                                        Width="{Binding FullyTestedPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=500}"/>
                                <Border Height="18" Background="#D97706"
                                        Width="{Binding PartiallyTestedPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=500}"/>
                                <Border CornerRadius="0,4,4,0" Height="18" Background="{StaticResource DangerBrush}"
                                        Width="{Binding UntestedPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=500}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Border Width="10" Height="10" Background="#22C55E" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock FontSize="12">
                                <Run Text="{Binding FullyTestedCount, Mode=OneWay}"/>
                                <Run Text=" Fully Tested"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Border Width="10" Height="10" Background="#D97706" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock FontSize="12">
                                <Run Text="{Binding PartiallyTestedCount, Mode=OneWay}"/>
                                <Run Text=" Partially Tested"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" Background="{StaticResource DangerBrush}" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock FontSize="12">
                                <Run Text="{Binding UntestedCount, Mode=OneWay}"/>
                                <Run Text=" Untested"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="No requirements yet — add some on the Requirements page to see coverage here."
                               Foreground="#6B7280" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalRequirements}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
