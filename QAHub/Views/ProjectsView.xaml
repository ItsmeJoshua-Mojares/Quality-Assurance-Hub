<UserControl x:Class="QAHub.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ProjectCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
        <Grid>

            <!-- ============ LIST VIEW ============ -->
            <StackPanel Visibility="{Binding IsListView, Converter={StaticResource BoolToVisConverter}}">

                <TextBlock Text="Projects" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Group test cases, runs, defects, and requirements by product"
                           Foreground="#6B7280" Margin="0,3,0,22"/>

                <UniformGrid Columns="3" Margin="0,0,-12,18">
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalProjects}" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="TOTAL PROJECTS" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="ACTIVE" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding ArchivedCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="#6B7280"/>
                            <TextBlock Text="ARCHIVED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Padding="8,6"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by name or owner"/>
                    <Button Grid.Column="2" Content="+ Create Project" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ShowCreateFormCommand}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding ProjectsView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProjectCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Cursor="Hand">
                                        <StackPanel.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenProjectCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </StackPanel.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </Grid>
                                        <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,3,0,0"
                                                   Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0"
                                                   Text="{Binding Owner, TargetNullValue='No owner set'}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Update" Style="{StaticResource SecondaryButtonStyle}"
                                            VerticalAlignment="Center" Margin="16,0,0,0"
                                            Command="{Binding DataContext.EditProjectCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No projects yet. Click Create Project to add the first one."
                           Foreground="#6B7280" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalProjects}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="No projects match your search." Foreground="#6B7280" Margin="0,10,0,0"
                           Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisConverter}}"/>
            </StackPanel>

            <!-- ============ READ-ONLY DETAIL VIEW ============ -->
            <StackPanel Visibility="{Binding IsReadOnlyView, Converter={StaticResource BoolToVisConverter}}">

                <Button Content="&#8592; Back to Projects" Command="{Binding BackToListCommand}"
                        HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource AccentBrush}" Cursor="Hand" Padding="0"
                        Margin="0,0,0,18"/>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SelectedProject.Name}"
                                       FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedProject.Status}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top"/>
                        </Grid>

                        <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,18">
                            <Run Text="Owner: "/>
                            <Run Text="{Binding SelectedProject.Owner, Mode=OneWay, TargetNullValue='Not set'}"/>
                            <Run Text=" • Last updated "/>
                            <Run Text="{Binding SelectedProject.UpdatedAt, Mode=OneWay, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}"/>
                        </TextBlock>

                        <TextBlock Text="{Binding SelectedProject.Description}" TextWrapping="Wrap"
                                   FontSize="14" LineHeight="22" Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Update" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding EditProjectCommand}"
                                    CommandParameter="{Binding SelectedProject}" Margin="0,0,10,0"/>
                            <Button Content="{Binding SelectedProject.Status, Converter={StaticResource ArchiveLabelConverter}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ArchiveProjectCommand}"
                                    CommandParameter="{Binding SelectedProject}" Margin="0,0,10,0"/>
                            <Button Content="Delete Project" Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteProjectCommand}"
                                    CommandParameter="{Binding SelectedProject}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ FORM VIEW (shared: Create new + Update existing) ============ -->
            <StackPanel Visibility="{Binding IsFormView, Converter={StaticResource BoolToVisConverter}}">

                <TextBlock Text="{Binding FormTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Padding="8,6" Margin="0,0,0,14"
                                 Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Owner" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Padding="8,6" ToolTip="Team or person responsible (optional)"
                                         Text="{Binding DraftOwner, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Padding="8,6"
                                          ItemsSource="{Binding Statuses}"
                                          SelectedItem="{Binding DraftStatus}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Padding="10,8" MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"
                                 Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding SaveButtonLabel}" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveFormCommand}" Margin="0,0,10,0"/>
                            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CancelFormCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
