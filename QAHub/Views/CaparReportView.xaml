<UserControl x:Class="QAHub.Views.CaparReportView" x:Name="Root"
             xmlns:ui="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>

        <Style x:Key="RegisterCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
        <StackPanel>

            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CAPAR Register" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Open corrective &amp; preventive actions, fed live from the CAPAR Tracker — closing a CAPAR removes it here"
                               Foreground="#6B7280" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <CheckBox IsChecked="{Binding ShowClosed}" Content="Show closed"
                              FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"
                              ToolTip="Closed CAPARs vanish by default. Check to bring the history back."/>
                    <Button Content="&#8635; Refresh" ui:AutomationProperties.Name="Refresh CAPAR Register"
                            Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="5" Margin="0,0,-12,22">
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveCount}" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="ACTIVE" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding ImplementedCount}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="IMPLEMENTED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding VerifiedCount}" FontSize="30" FontWeight="Bold"
                                   Foreground="#D97706"/>
                        <TextBlock Text="VERIFIED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding CriticalCount}" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="CRITICAL" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding OverdueCount}" FontSize="30" FontWeight="Bold"
                                   Foreground="#D97706"/>
                        <TextBlock Text="OVERDUE" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{Binding ShownCountLabel}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RegisterCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Style="{StaticResource CardClickButtonStyle}"
                                                ui:AutomationProperties.Name="{Binding CaparNumber, StringFormat={}Open {0}}"
                                                Command="{Binding DataContext.SelectItemCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding CaparNumber}"
                                                               FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                </Grid>
                                                <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,3,0,0"
                                                           TextWrapping="Wrap" MaxWidth="600"
                                                           Text="{Binding Title, TargetNullValue='Untitled'}"/>
                                                <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0">
                                                    <Run Text="{Binding Source, Mode=OneWay}"/>
                                                    <Run Text="• "/>
                                                    <Run Text="{Binding Severity, Mode=OneWay}"/>
                                                    <Run Text="• "/>
                                                    <Run Text="{Binding Project, Mode=OneWay}"/>
                                                    <Run Text="• "/>
                                                    <Run Text="{Binding Owner, Mode=OneWay}"/>
                                                    <Run Text="• Due "/>
                                                    <Run Text="{Binding DueDate, Mode=OneWay, StringFormat=d, TargetNullValue='—'}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Content="Print" Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="16,0,0,0" VerticalAlignment="Center"
                                                ui:AutomationProperties.Name="{Binding CaparNumber, StringFormat={}Print {0}}"
                                                Command="{Binding DataContext.PrintRowCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No open CAPARs right now. File a new one on the CAPAR Tracker and it will appear here; close it and it will vanish."
                               Foreground="#6B7280">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Full detail panel for the selected CAPAR (the "docs" view of the New CAPAR fields) -->
            <Border Style="{StaticResource StatCardStyle}"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Selected.CaparNumber}"
                                   FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="1" Text="{Binding Selected.Status}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top"/>
                    </Grid>

                    <TextBlock Text="{Binding Selected.Title}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#111827" TextWrapping="Wrap" Margin="0,2,0,18"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Text="SEVERITY" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Text="{Binding Selected.Severity}" FontSize="14" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                            <TextBlock Text="PROJECT" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Text="{Binding Selected.Project}" FontSize="14" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Text="OWNER" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Text="{Binding Selected.Owner}" FontSize="14" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Text="OPENED" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Text="{Binding Selected.OpenedDate, StringFormat=d}" FontSize="14" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                            <TextBlock Text="DUE" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Text="{Binding Selected.DueDate, StringFormat=d, TargetNullValue='—'}"
                                       FontSize="14" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Text="CLOSED" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Text="{Binding Selected.ClosedDate, StringFormat=d, TargetNullValue='—'}"
                                       FontSize="14" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Source" Style="{StaticResource DetailLabelStyle}"/>
                    <TextBlock Text="{Binding Selected.Source}" TextWrapping="Wrap" FontSize="13"
                               Foreground="#6B7280" Margin="0,3,0,14"/>

                    <TextBlock Text="Root Cause" Style="{StaticResource DetailLabelStyle}"/>
                    <TextBlock Text="{Binding Selected.RootCause, TargetNullValue='None recorded.'}"
                               TextWrapping="Wrap" FontSize="13" Foreground="#6B7280" Margin="0,3,0,14"/>

                    <TextBlock Text="Corrective Action" Style="{StaticResource DetailLabelStyle}"/>
                    <TextBlock Text="{Binding Selected.CorrectiveAction, TargetNullValue='None recorded.'}"
                               TextWrapping="Wrap" FontSize="13" Foreground="#6B7280" Margin="0,3,0,14"/>

                    <TextBlock Text="Preventive Action" Style="{StaticResource DetailLabelStyle}"/>
                    <TextBlock Text="{Binding Selected.PreventiveAction, TargetNullValue='None recorded.'}"
                               TextWrapping="Wrap" FontSize="13" Foreground="#6B7280" Margin="0,3,0,14"/>

                    <TextBlock Text="Remarks" Style="{StaticResource DetailLabelStyle}"/>
                    <TextBlock Text="{Binding Selected.Remarks, TargetNullValue='No remarks.'}"
                               TextWrapping="Wrap" FontSize="13" Foreground="#6B7280" Margin="0,3,0,18"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Print this CAPAR" ui:AutomationProperties.Name="Print Selected CAPAR"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding PrintRowCommand}" CommandParameter="{Binding Selected}"
                                Margin="0,0,10,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>