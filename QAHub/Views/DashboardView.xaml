<UserControl x:Class="QAHub.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
        <StackPanel>

            <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Central overview of your software quality process"
                       Foreground="#6B7280" Margin="0,3,0,22"/>

            <UniformGrid Columns="4" Margin="0,0,-12,0">
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalTestCases}" FontSize="34" FontWeight="Bold"/>
                        <TextBlock Text="TOTAL TEST CASES" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding PassRate}" FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="PASS RATE" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding OpenBugs}" FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="OPEN BUGS" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding BlockedCases}" FontSize="34" FontWeight="Bold"
                                   Foreground="#D97706"/>
                        <TextBlock Text="BLOCKED CASES" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Test Case Status Breakdown" FontSize="15" FontWeight="SemiBold"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="Passed" Foreground="#4ADE80"/>
                                <TextBlock Text="{Binding PassedCases}" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="Failed"/>
                                <TextBlock Text="{Binding FailedCases}" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="Draft"/>
                                <TextBlock Text="{Binding DraftCases}" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="Blocked"/>
                                <TextBlock Text="{Binding BlockedCases}" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Open Bugs" Foreground="{StaticResource DangerBrush}"/>
                                <TextBlock Text="{Binding OpenBugsLabel}" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Recent Open Bugs" FontSize="15" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding RecentBugs}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource DangerBrush}"
                                                 VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13"
                                                   TextWrapping="Wrap" Margin="4,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No open bugs." FontSize="13" Foreground="#6B7280" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OpenBugs}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>