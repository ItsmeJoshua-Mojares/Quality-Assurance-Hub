<UserControl x:Class="QAHub.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="TableHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
        <StackPanel>

            <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Central overview of your software quality process"
                       Foreground="#6B7280" Margin="0,3,0,22"/>

            <!-- Stat cards -->
            <UniformGrid Columns="5" Margin="0,0,-12,18">
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalTestCases}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="TOTAL TEST CASES" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalTestRuns}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="TEST RUNS" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding OpenBugs}" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="OPEN DEFECTS" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding PassedCases}" FontSize="30" FontWeight="Bold"
                                   Foreground="#22C55E"/>
                        <TextBlock Text="PASSED TESTS" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding PassRate}" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="OVERALL PASS RATE" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Trend chart / Defect severity (placeholder) / Quick actions -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <!-- Test Execution Trend -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Test Execution Trend" FontSize="15" FontWeight="SemiBold"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Width="8" Height="8" Background="#22C55E" CornerRadius="4" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Passed" FontSize="11" Foreground="#6B7280" Margin="0,0,10,0"/>
                                <Border Width="8" Height="8" Background="{StaticResource DangerBrush}" CornerRadius="4" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Failed" FontSize="11" Foreground="#6B7280" Margin="0,0,10,0"/>
                                <Border Width="8" Height="8" Background="#9CA3AF" CornerRadius="4" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Blocked" FontSize="11" Foreground="#6B7280"/>
                            </StackPanel>
                        </Grid>

                        <Canvas Width="460" Height="140" HorizontalAlignment="Left">
                            <Polyline Points="{Binding PassedTrendPoints}" Stroke="#22C55E" StrokeThickness="2"/>
                            <Polyline Points="{Binding FailedTrendPoints}" Stroke="{StaticResource DangerBrush}" StrokeThickness="2"/>
                            <Polyline Points="{Binding BlockedTrendPoints}" Stroke="#9CA3AF" StrokeThickness="2"/>
                        </Canvas>

                        <ItemsControl ItemsSource="{Binding TrendDayLabels}" Width="460" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No execution data yet — mark items Pass/Fail/Blocked in a Test Run to see trends here."
                                   Foreground="#6B7280" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasTrendData, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}"/>
                    </StackPanel>
                </Border>

                <!-- Defect Severity (real data from Bug.Severity) -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Defect Severity" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                        <Grid Visibility="{Binding HasDefectsForSeverityChart, Converter={StaticResource BoolToVisConverter}}">
                            <Canvas Width="130" Height="130" HorizontalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding DefectSeveritySlices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding Geometry}" Fill="{Binding Fill}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding SeverityChartTotal}" FontSize="26" FontWeight="Bold"
                                           Canvas.Left="0" Canvas.Top="48" Width="130" TextAlignment="Center"/>
                                <TextBlock Text="Open Defects" FontSize="10" Foreground="#9CA3AF"
                                           Canvas.Left="0" Canvas.Top="76" Width="130" TextAlignment="Center"/>
                            </Canvas>

                            <ItemsControl ItemsSource="{Binding DefectSeveritySlices}" Margin="0,16,0,0"
                                          VerticalAlignment="Bottom">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding Fill}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12"
                                                       FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PercentLabel}" FontSize="11"
                                                       Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <TextBlock Text="No open defects — the chart will fill in once there are some."
                                   FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,20,0,0"
                                   Visibility="{Binding HasDefectsForSeverityChart, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}"/>
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <Border Grid.Column="4" Style="{StaticResource StatCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Quick Actions" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <Button Style="{StaticResource QuickActionButtonStyle}" Command="{Binding CreateTestCaseCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Create Test Case" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="&#8594;" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource QuickActionButtonStyle}" Command="{Binding LogDefectCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Log Defect" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="&#8594;" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource QuickActionButtonStyle}" Command="{Binding StartTestRunCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Start Test Run" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="&#8594;" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Test Runs / Recent Defects -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Recent Test Runs" FontSize="15" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="View all →" Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding ViewAllRunsCommand}"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RUN NAME" Style="{StaticResource TableHeaderStyle}"/>
                            <TextBlock Grid.Column="1" Text="STATUS" Style="{StaticResource TableHeaderStyle}"/>
                            <TextBlock Grid.Column="2" Text="PASS RATE" Style="{StaticResource TableHeaderStyle}"/>
                            <TextBlock Grid.Column="3" Text="DATE" Style="{StaticResource TableHeaderStyle}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentRuns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding BuildVersion, TargetNullValue='No build set'}"
                                                       FontSize="11" Foreground="#9CA3AF"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PassRatePercent, StringFormat={}{0}%}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding CreatedAt, StringFormat={}{0:MMM d}}"
                                                   FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No test runs yet." FontSize="13" Foreground="#6B7280" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalTestRuns}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Recent Defects" FontSize="15" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="View all →" Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding ViewAllDefectsCommand}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentDefects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource DangerBrush}"
                                                 VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap"/>
                                            <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0">
                                                <Run Text="{Binding Status, Mode=OneWay}"/>
                                                <Run Text=" • "/>
                                                <Run Text="{Binding OpenedDate, Mode=OneWay, StringFormat={}{0:MMM d}}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No open defects." FontSize="13" Foreground="#6B7280" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OpenBugs}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
