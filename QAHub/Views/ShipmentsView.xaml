<UserControl x:Class="QAHub.Views.ShipmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ShipmentCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ProjectCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
        <Grid>

            <!-- ============ PROJECTS DASHBOARD ============ -->
            <StackPanel Visibility="{Binding IsProjectsView, Converter={StaticResource BoolToVisConverter}}">

                <TextBlock Text="Shipment Tracker" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Select a project to see the serial numbers shipped under it"
                           Foreground="#6B7280" Margin="0,3,0,22"/>

                <UniformGrid Columns="5" Margin="0,0,-12,18">
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalShipments}" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="TOTAL" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding QaPassedCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="QA PASSED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding QaReadyCount}" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="QA READY" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding QaBlockedCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text="QA BLOCKED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding QaInProgressCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="#D97706"/>
                            <TextBlock Text="QA IN PROGRESS" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBox Padding="8,6" Margin="0,0,0,18"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search projects by name"/>

                <ItemsControl ItemsSource="{Binding ProjectSummariesView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProjectCardStyle}">
                                <StackPanel Cursor="Hand">
                                    <StackPanel.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenProjectCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding Project}"/>
                                    </StackPanel.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Project.Name}"
                                                   FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Project.Status}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </Grid>
                                    <TextBlock FontSize="13" Foreground="#6B7280" Margin="0,6,0,0">
                                        <Run Text="{Binding ShipmentCount, Mode=OneWay}"/>
                                        <Run Text="serial(s) shipped"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No projects yet. Create one in the Projects page first."
                           Foreground="#6B7280" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalProjects}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="No projects match your search." Foreground="#6B7280" Margin="0,10,0,0"
                           Visibility="{Binding HasNoProjectSearchResults, Converter={StaticResource BoolToVisConverter}}"/>
            </StackPanel>

            <!-- ============ PROJECT SHIPMENTS VIEW ============ -->
            <StackPanel Visibility="{Binding IsProjectShipmentsView, Converter={StaticResource BoolToVisConverter}}">

                <Button Content="&#8592; Back to Projects" Command="{Binding BackToProjectsCommand}"
                        HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource AccentBrush}" Cursor="Hand" Padding="0"
                        Margin="0,0,0,18"/>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding SelectedProject.Name}" FontSize="24" FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding SelectedProject.Status}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="•" FontSize="12" Foreground="#9CA3AF" Margin="10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedProjectShipmentCount}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock Text=" serial(s)" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ New Shipment" Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Center" Margin="16,0,0,0"
                            Command="{Binding ShowCreateFormCommand}"/>
                </Grid>

                <Grid Margin="0,0,0,18">
                    <TextBox Padding="8,6"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by serial number, model, firmware, or location"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding ShipmentsView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ShipmentCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Cursor="Hand">
                                        <StackPanel.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenShipmentCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </StackPanel.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SerialNumber}"
                                                       FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QaStatus}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </Grid>
                                        <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,3,0,0"
                                                   Text="{Binding Model, TargetNullValue='No model set'}"/>
                                        <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0">
                                            <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                            <Run Text="•"/>
                                            <Run Text="FW "/>
                                            <Run Text="{Binding FirmwareVersion, Mode=OneWay}"/>
                                            <Run Text="•"/>
                                            <Run Text="{Binding Location, Mode=OneWay, TargetNullValue='No location'}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button Content="Update" Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,0"
                                                Command="{Binding DataContext.EditShipmentCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DataContext.DeleteShipmentCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No shipments for this project yet. Click New Shipment to add the first one."
                           Foreground="#6B7280" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProjectShipmentCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="No shipments match your search." Foreground="#6B7280" Margin="0,10,0,0"
                           Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisConverter}}"/>
            </StackPanel>

            <!-- ============ READ-ONLY DETAIL VIEW ============ -->
            <StackPanel Visibility="{Binding IsReadOnlyView, Converter={StaticResource BoolToVisConverter}}">

                <Button Content="&#8592; Back to Shipments" Command="{Binding BackToListCommand}"
                        HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource AccentBrush}" Cursor="Hand" Padding="0"
                        Margin="0,0,0,18"/>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SelectedShipment.SerialNumber}"
                                       FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedShipment.QaStatus}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top"/>
                        </Grid>

                        <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,18">
                            <Run Text="{Binding SelectedShipment.ProjectName, Mode=OneWay}"/>
                            <Run Text="• Last updated "/>
                            <Run Text="{Binding SelectedShipment.UpdatedAt, Mode=OneWay, StringFormat={}{0:MMM d, yyyy h:mm tt}}"/>
                        </TextBlock>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="PROJECT" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedShipment.ProjectName}" FontSize="14" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                <TextBlock Text="MODEL" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedShipment.Model}" FontSize="14" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="FIRMWARE VERSION" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedShipment.FirmwareVersion}" FontSize="14" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="SHIPMENT DATE" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedShipment.ShipmentDate, StringFormat=d}"
                                           FontSize="14" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                <TextBlock Text="QA STATUS" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedShipment.QaStatus}" FontSize="14" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="LOCATION" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedShipment.Location, TargetNullValue='Not set'}"
                                           FontSize="14" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Remarks" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Text="{Binding SelectedShipment.Remarks, TargetNullValue='No remarks.'}"
                                   TextWrapping="Wrap" FontSize="13" Foreground="#6B7280" Margin="0,3,0,18"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Update" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding EditShipmentCommand}"
                                    CommandParameter="{Binding SelectedShipment}" Margin="0,0,10,0"/>
                            <Button Content="Delete Shipment" Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteShipmentCommand}"
                                    CommandParameter="{Binding SelectedShipment}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ FORM VIEW (shared: Create new + Update existing) ============ -->
            <StackPanel Visibility="{Binding IsFormView, Converter={StaticResource BoolToVisConverter}}">

                <TextBlock Text="{Binding FormTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Project" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Padding="8,6"
                                          ItemsSource="{Binding Projects}"
                                          SelectedItem="{Binding DraftProject}"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Shipment Date" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker Padding="8,6"
                                            SelectedDate="{Binding DraftShipmentDate}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Serial Number" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Padding="8,6" Margin="0,0,0,14"
                                 Text="{Binding DraftSerialNumber, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Model" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Padding="8,6"
                                         Text="{Binding DraftModel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Firmware Version" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Padding="8,6"
                                         Text="{Binding DraftFirmwareVersion, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="QA Status" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Padding="8,6"
                                          ItemsSource="{Binding QaStatuses}"
                                          SelectedItem="{Binding DraftQaStatus}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Location" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Padding="8,6"
                                         Text="{Binding DraftLocation, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Current physical location (optional)"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Remarks" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Padding="10,8" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"
                                 Text="{Binding DraftRemarks, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding SaveButtonLabel}" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveFormCommand}" Margin="0,0,10,0"/>
                            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CancelFormCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>