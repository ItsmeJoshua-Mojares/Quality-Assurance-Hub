<UserControl x:Class="QAHub.Views.BugsView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:models="clr-namespace:QAHub.Models">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="SeverityValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:Severity"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="BugStatusValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:BugStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="GridCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26">

        <!-- ============ LIST VIEW ============ -->
        <Grid Visibility="{Binding IsListView, Converter={StaticResource BoolToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Bugs" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Track defects found during testing"
                               Foreground="#6B7280" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DeleteCommand}" Margin="0,0,10,0"/>
                    <Button Content="+ Log Defect" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ShowCreateFormCommand}"/>
                </StackPanel>
            </Grid>

            <TextBox Grid.Row="1" Padding="8,7" Margin="0,0,0,14" MaxWidth="360" HorizontalAlignment="Left"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search by title or assignee"/>

            <Border Grid.Row="2" Style="{StaticResource GridCardStyle}">
                <DataGrid ItemsSource="{Binding ItemsView}"
                          SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          RowHeight="36"
                          RowHeaderWidth="0"
                          BorderThickness="0"
                          Background="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F1F3"
                          AlternatingRowBackground="#FAFAFB"
                          CellEditEnding="Grid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Width="45" IsReadOnly="True" Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="Title" Width="2*" Binding="{Binding Title}"/>
                        <DataGridTextColumn Header="Description" Width="3*" Binding="{Binding Description}"/>
                        <DataGridComboBoxColumn Header="Severity" Width="1*"
                                                ItemsSource="{Binding Source={StaticResource SeverityValues}}"
                                                SelectedItemBinding="{Binding Severity}"/>
                        <DataGridComboBoxColumn Header="Status" Width="1*"
                                                ItemsSource="{Binding Source={StaticResource BugStatusValues}}"
                                                SelectedItemBinding="{Binding Status}"/>
                        <DataGridTextColumn Header="Assignee" Width="1*" Binding="{Binding Assignee}"/>
                        <DataGridTextColumn Header="Opened" Width="1*"
                                            Binding="{Binding OpenedDate, StringFormat=d}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ============ FORM VIEW (inline Log Defect) ============ -->
        <StackPanel Visibility="{Binding IsFormView, Converter={StaticResource BoolToVisConverter}}">

            <TextBlock Text="Log Defect" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Fill in the details below, then save."
                       Foreground="#6B7280" Margin="0,3,0,22"/>

            <Border Style="{StaticResource StatCardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Title" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Padding="8,6" Margin="0,0,0,14"
                             Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Padding="10,8" MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"
                             Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Severity" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Padding="8,6"
                                      ItemsSource="{Binding Severities}"
                                      SelectedItem="{Binding DraftSeverity}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Padding="8,6"
                                      ItemsSource="{Binding Statuses}"
                                      SelectedItem="{Binding DraftStatus}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Assignee" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Padding="8,6"
                                     Text="{Binding DraftAssignee, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Opened Date" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker Padding="8,6" SelectedDate="{Binding DraftOpenedDate}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save Defect" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveFormCommand}" Margin="0,0,10,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</UserControl>
