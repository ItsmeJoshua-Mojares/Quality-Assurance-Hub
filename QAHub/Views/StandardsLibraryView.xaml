<UserControl x:Class="QAHub.Views.StandardsLibraryView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <UserControl.Resources>
        <Style x:Key="DocCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <DataTemplate x:Key="CategoryItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource StandardCategoryLabelConverter}}"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>

        <!-- ============ LIST + FORM PANE (not visible while previewing a PDF) ============ -->
        <ScrollViewer Padding="26" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsListOrForm, Converter={StaticResource BoolToVisConverter}}">
            <Grid>

                <!-- LIST VIEW -->
                <StackPanel Visibility="{Binding IsListView, Converter={StaticResource BoolToVisConverter}}">

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Standards Library" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="Standards, specifications, and reference documents for the QA team"
                                       Foreground="#6B7280" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="+ Register Document" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ShowRegisterFormCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Padding="8,6"
                                 ToolTip="Search by title, description, or file name"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Grid.Column="2" Padding="8,6"
                                  ItemsSource="{Binding FilterOptions}"
                                  SelectedItem="{Binding CategoryFilter}"
                                  DisplayMemberPath="Label"/>
                    </Grid>

                    <TextBlock Text="{Binding TotalDocuments, StringFormat='{}{0} document(s) registered'}"
                               FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding DocumentsView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DocCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Extension pill -->
                                        <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="8"
                                                Padding="10,12" Margin="0,0,14,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding ExtensionDisplay}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </Border>

                                        <!-- Clickable summary (opens the document) -->
                                        <StackPanel Grid.Column="1" Cursor="Hand">
                                            <StackPanel.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenDocumentCommand,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </StackPanel.InputBindings>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                                                <Border Background="{Binding Category,
                                                                 Converter={StaticResource StandardCategoryBrushConverter}}"
                                                        CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category,
                                                               Converter={StaticResource StandardCategoryLabelConverter}}"
                                                               FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,3,0,0"
                                                       Text="{Binding Description}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="620"/>
                                            <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0" MaxWidth="620">
                                                <Run Text="{Binding FileName, Mode=OneWay}"/>
                                                <Run Text="  &#x2022;  "/>
                                                <Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                                <Run Text="  Uploaded "/>
                                                <Run Text="{Binding UploadedAt, Mode=OneWay, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="18,0,0,0">
                                            <Button Content="Open" Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding DataContext.OpenDocumentCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Update" Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding DataContext.EditDocumentCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                                                    Command="{Binding DataContext.DeleteDocumentCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No documents yet. Click Register Document to add the first standard."
                               Foreground="#6B7280" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalDocuments}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="No documents match your search." Foreground="#6B7280" Margin="0,10,0,0"
                               Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisConverter}}"/>
                </StackPanel>

                <!-- FORM VIEW (register / edit) -->
                <StackPanel Visibility="{Binding IsFormView, Converter={StaticResource BoolToVisConverter}}">

                    <TextBlock Text="{Binding FormTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Title" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Padding="8,6" Margin="0,0,0,14"
                                     Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Category" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox Padding="8,6"
                                              ItemsSource="{Binding AllCategories}"
                                              SelectedItem="{Binding DraftCategory}"
                                              ItemTemplate="{StaticResource CategoryItemTemplate}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="File" Style="{StaticResource FieldLabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Choose File" Margin="0,0,10,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="BrowseFile_Click"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="#6B7280" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding FileHintText, Mode=OneWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Padding="10,8" MinHeight="110" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"
                                     Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding SaveButtonLabel}" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveFormCommand}" Margin="0,0,10,0"/>
                                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CancelFormCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- ============ PDF PREVIEW PANE ============ -->
        <Grid Margin="26" Visibility="{Binding IsPreviewView, Converter={StaticResource BoolToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="&#8592; Back to Standards Library" Command="{Binding BackToListCommand}"
                    HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource AccentBrush}" Cursor="Hand" Padding="0"
                    Margin="0,0,0,14"/>

            <Border Grid.Row="1" Style="{StaticResource StatCardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PreviewDocument.Title}" FontSize="20" FontWeight="Bold"
                                       TextWrapping="Wrap" MaxWidth="860"/>
                            <Border Background="{Binding PreviewDocument.Category,
                                             Converter={StaticResource StandardCategoryBrushConverter}}"
                                    CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding PreviewDocument.Category,
                                                   Converter={StaticResource StandardCategoryLabelConverter}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0">
                            <Run Text="{Binding PreviewDocument.FileName, Mode=OneWay}"/>
                            <Run Text="  &#x2022;  "/>
                            <Run Text="{Binding PreviewDocument.SizeDisplay, Mode=OneWay}"/>
                            <Run Text="  Uploaded "/>
                            <Run Text="{Binding PreviewDocument.UploadedAt, Mode=OneWay, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open in external viewer" VerticalAlignment="Top"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenDocumentCommand}" CommandParameter="{Binding PreviewDocument}"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="2">
                <wv2:WebView2 x:Name="PdfViewer"/>
            </Border>
        </Grid>

    </Grid>
</UserControl>