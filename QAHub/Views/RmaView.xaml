<UserControl x:Class="QAHub.Views.RmaView" x:Name="Root"
             xmlns:ui="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="RmaCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ProjectCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="26">
        <Grid>

            <!-- ============ PROJECTS DASHBOARD ============ -->
            <StackPanel Visibility="{Binding IsProjectsView, Converter={StaticResource BoolToVisConverter}}">

                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="RMA Tracker" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Select a project to see the units returned under it"
                                   Foreground="#6B7280" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#8635; Refresh" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>

                <UniformGrid Columns="5" Margin="0,0,-12,18">
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalItems}" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="TOTAL" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding OpenCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="OPEN" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding SubmittedCount}" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="RECEIVED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding RepairCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="#D97706"/>
                            <TextBlock Text="IN WORK" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding ClosedCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="CLOSED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBox Padding="8,6" Margin="0,0,0,18"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search projects by name"/>

                <ItemsControl ItemsSource="{Binding ProjectSummariesView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProjectCardStyle}">
                                <Button Style="{StaticResource CardClickButtonStyle}"
                                        ui:AutomationProperties.Name="{Binding ProjectName, StringFormat={}Open project {0}}"
                                        Command="{Binding DataContext.OpenProjectCommand,
                                                  ElementName=Root}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProjectName}"
                                                       FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </Grid>
                                        <TextBlock FontSize="13" Foreground="#6B7280" Margin="0,6,0,0">
                                            <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                            <Run Text=" RMA(s)"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No RMAs yet. Open a project to add the first one."
                           Foreground="#6B7280" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalItems}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="No projects match your search." Foreground="#6B7280" Margin="0,10,0,0"
                           Visibility="{Binding HasNoProjectSearchResults, Converter={StaticResource BoolToVisConverter}}"/>
            </StackPanel>

            <!-- ============ PROJECT RMAS VIEW ============ -->
            <StackPanel Visibility="{Binding IsProjectItemsView, Converter={StaticResource BoolToVisConverter}}">

                <Button Content="&#8592; Back to Projects" ui:AutomationProperties.Name="Back to Projects" Command="{Binding BackToProjectsCommand}"
                        HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource AccentBrush}" Cursor="Hand" Padding="0"
                        Margin="0,0,0,18"/>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding SelectedProjectDisplayName}" FontSize="24" FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedProjectItemCount, StringFormat={}{0} RMA(s)}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="&#8635; Refresh" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                        <Button Content="+ New RMA" ui:AutomationProperties.Name="New RMA" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ShowCreateFormCommand}"/>
                    </StackPanel>
                </Grid>

                <TextBox Padding="8,6" Margin="0,0,0,18"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by RMA number, serial, model, customer, project, or reason"/>

                <ItemsControl ItemsSource="{Binding ItemsView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RmaCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource CardClickButtonStyle}"
                                        ui:AutomationProperties.Name="{Binding RmaNumber, StringFormat={}Open {0}}"
                                        Command="{Binding DataContext.OpenItemCommand,
                                                  ElementName=Root}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding RmaNumber}"
                                                       FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </Grid>
                                        <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,3,0,0"
                                                   Text="{Binding SerialNumber, TargetNullValue='No serial'}"/>
                                        <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0">
                                            <Run Text="{Binding Project, Mode=OneWay, TargetNullValue='Unassigned'}"/>
                                            <Run Text="• "/>
                                            <Run Text="{Binding Customer, Mode=OneWay, TargetNullValue='No customer'}"/>
                                            <Run Text="• "/>
                                            <Run Text="{Binding Model, Mode=OneWay}"/>
                                            <Run Text="• Received "/>
                                            <Run Text="{Binding ReceivedDate, Mode=OneWay, StringFormat=d}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button Content="Update" Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,0"
                                                ui:AutomationProperties.Name="{Binding RmaNumber, StringFormat={}Update {0}}"
                                                Command="{Binding DataContext.EditItemCommand,
                                                          ElementName=Root}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                                                ui:AutomationProperties.Name="{Binding RmaNumber, StringFormat={}Delete {0}}"
                                                Command="{Binding DataContext.DeleteItemCommand,
                                                          ElementName=Root}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No RMAs for this project yet. Click + New RMA to add the first one."
                           Foreground="#6B7280" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProjectItemCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="No RMAs match your search." Foreground="#6B7280" Margin="0,10,0,0"
                           Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisConverter}}"/>
            </StackPanel>

            <!-- ============ READ-ONLY DETAIL VIEW ============ -->
            <StackPanel Visibility="{Binding IsReadOnlyView, Converter={StaticResource BoolToVisConverter}}">

                <Button Content="&#8592; Back to RMAs" ui:AutomationProperties.Name="Back to RMAs" Command="{Binding BackToListCommand}"
                        HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource AccentBrush}" Cursor="Hand" Padding="0"
                        Margin="0,0,0,18"/>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Selected.RmaNumber}"
                                       FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding Selected.Status}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top"/>
                        </Grid>

                        <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,18">
                            <Run Text="{Binding Selected.SerialNumber, Mode=OneWay}"/>
                            <Run Text="• Last updated "/>
                            <Run Text="{Binding Selected.UpdatedAt, Mode=OneWay, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}"/>
                        </TextBlock>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="SERIAL NUMBER" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Selected.SerialNumber}" FontSize="14" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                <TextBlock Text="MODEL" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Selected.Model}" FontSize="14" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="PROJECT" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Selected.Project, TargetNullValue='Unassigned'}"
                                           FontSize="14" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="CUSTOMER" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Selected.Customer}" FontSize="14" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                <TextBlock Text="RECEIVED DATE" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Selected.ReceivedDate, StringFormat=d}"
                                           FontSize="14" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Reason" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Text="{Binding Selected.Reason, TargetNullValue='No reason given.'}"
                                   TextWrapping="Wrap" FontSize="13" Foreground="#6B7280" Margin="0,3,0,18"/>

                        <TextBlock Text="Remarks" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Text="{Binding Selected.Remarks, TargetNullValue='No remarks.'}"
                                   TextWrapping="Wrap" FontSize="13" Foreground="#6B7280" Margin="0,3,0,18"/>

                        <StackPanel Orientation="Horizontal">
<Button Content="Update" ui:AutomationProperties.Name="Update Selected" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding EditItemCommand}"
                                        CommandParameter="{Binding Selected}" Margin="0,0,10,0"/>
<Button Content="Delete RMA" ui:AutomationProperties.Name="Delete Selected" Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding DeleteItemCommand}"
                                        CommandParameter="{Binding Selected}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ FORM VIEW (shared: Create new + Update existing) ============ -->
            <StackPanel Visibility="{Binding IsFormView, Converter={StaticResource BoolToVisConverter}}">

                <TextBlock Text="{Binding FormTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RMA Number" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Padding="8,6"
                                         Text="{Binding DraftRmaNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Received Date" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker Padding="8,6"
                                            SelectedDate="{Binding DraftReceivedDate}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Serial Number" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Padding="8,6" Margin="0,0,0,14" ui:AutomationProperties.Name="FormSerial"
                                 Text="{Binding DraftSerialNumber, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Model" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Padding="8,6" ui:AutomationProperties.Name="FormModel"
                                         Text="{Binding DraftModel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Project" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Padding="8,6"
                                          ItemsSource="{Binding Projects}"
                                          SelectedItem="{Binding DraftProject}"
                                          IsEditable="True"
                                          IsEnabled="{Binding CanChangeProject}"/>
                                <TextBlock Text="Filed under this project" FontSize="11"
                                           Foreground="#6B7280" Margin="0,4,0,0"
                                           Visibility="{Binding IsProjectLocked, Converter={StaticResource BoolToVisConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Customer" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Padding="8,6"
                                         Text="{Binding DraftCustomer, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Padding="8,6"
                                          ItemsSource="{Binding Statuses}"
                                          SelectedItem="{Binding DraftStatus}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Reason" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Padding="10,8" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"
                                 Text="{Binding DraftReason, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Remarks" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Padding="10,8" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"
                                 Text="{Binding DraftRemarks, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding SaveButtonLabel}" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveFormCommand}" Margin="0,0,10,0"/>
                            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CancelFormCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>