<UserControl x:Class="QAHub.Views.RequirementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="RequirementCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
        <Grid>

            <!-- ============ LIST VIEW ============ -->
            <StackPanel Visibility="{Binding IsListView, Converter={StaticResource BoolToVisConverter}}">

                <TextBlock Text="Requirements" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Trace requirements to the test cases that cover them"
                           Foreground="#6B7280" Margin="0,3,0,22"/>

                <UniformGrid Columns="4" Margin="0,0,-12,18">
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalRequirements}" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="TOTAL" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding FullyTestedCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="#22C55E"/>
                            <TextBlock Text="FULLY TESTED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding PartiallyTestedCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="#D97706"/>
                            <TextBlock Text="PARTIALLY TESTED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding UntestedCount}" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text="UNTESTED" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Padding="8,6"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by title or source"/>
                    <Button Grid.Column="2" Content="+ Create Requirement" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ShowCreateFormCommand}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding RequirementsView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RequirementCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Cursor="Hand">
                                        <StackPanel.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenRequirementCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </StackPanel.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CoverageStatus}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </Grid>
                                        <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,3,0,0"
                                                   Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0">
                                            <Run Text="{Binding Source, TargetNullValue='No source set', Mode=OneWay}"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding LinkedTestCaseIds.Count, Mode=OneWay}"/>
                                            <Run Text=" test case(s) linked"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Update" Style="{StaticResource SecondaryButtonStyle}"
                                            VerticalAlignment="Center" Margin="16,0,0,0"
                                            Command="{Binding DataContext.EditRequirementCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No requirements yet. Click Create Requirement to add the first one."
                           Foreground="#6B7280" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalRequirements}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="No requirements match your search." Foreground="#6B7280" Margin="0,10,0,0"
                           Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisConverter}}"/>
            </StackPanel>

            <!-- ============ READ-ONLY DETAIL VIEW ============ -->
            <StackPanel Visibility="{Binding IsReadOnlyView, Converter={StaticResource BoolToVisConverter}}">

                <Button Content="&#8592; Back to Requirements" Command="{Binding BackToListCommand}"
                        HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource AccentBrush}" Cursor="Hand" Padding="0"
                        Margin="0,0,0,18"/>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SelectedRequirement.Title}"
                                       FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedRequirement.CoverageStatus}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top"/>
                        </Grid>

                        <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,18">
                            <Run Text="Source: "/>
                            <Run Text="{Binding SelectedRequirement.Source, Mode=OneWay, TargetNullValue='Not set'}"/>
                            <Run Text=" • Last updated "/>
                            <Run Text="{Binding SelectedRequirement.UpdatedAt, Mode=OneWay, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}"/>
                        </TextBlock>

                        <TextBlock Text="{Binding SelectedRequirement.Description}" TextWrapping="Wrap"
                                   FontSize="14" LineHeight="22" Margin="0,0,0,18"/>

                        <TextBlock Text="Covered by" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Text="{Binding LinkedTestCaseNamesDisplay}"
                                   TextWrapping="Wrap" FontSize="13" Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Update" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding EditRequirementCommand}"
                                    CommandParameter="{Binding SelectedRequirement}" Margin="0,0,10,0"/>
                            <Button Content="Delete Requirement" Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteRequirementCommand}"
                                    CommandParameter="{Binding SelectedRequirement}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ FORM VIEW (shared: Create new + Update existing) ============ -->
            <StackPanel Visibility="{Binding IsFormView, Converter={StaticResource BoolToVisConverter}}">

                <TextBlock Text="{Binding FormTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Title" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Padding="8,6" Margin="0,0,0,14"
                                 Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Source" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Padding="8,6" ToolTip="Spec doc, ticket, or stakeholder"
                                         Text="{Binding DraftSource, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Coverage Status" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Padding="8,6"
                                          ItemsSource="{Binding CoverageStatuses}"
                                          SelectedItem="{Binding DraftCoverageStatus}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Padding="10,8" MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"
                                 Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Covered By" Style="{StaticResource FieldLabelStyle}"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Margin="0,0,0,18">
                            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DraftLinkedTestCases}" Margin="10,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected}"
                                                      Margin="0,4" FontSize="13"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Text="No test cases yet — create some on the Test Cases page first."
                                   FontSize="11" Foreground="#9CA3AF" Margin="0,-12,0,18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DraftLinkedTestCases.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding SaveButtonLabel}" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveFormCommand}" Margin="0,0,10,0"/>
                            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CancelFormCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
