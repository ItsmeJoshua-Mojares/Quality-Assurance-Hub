<Window x:Class="QAHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QA Hub" Width="980" Height="640"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,28">
                    <TextBlock Text="QA HUB" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource SidebarLogoBrush}"/>
                    <TextBlock Text="Quality &amp; Testing Center" FontSize="11"
                               Foreground="{StaticResource SidebarTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0">
                        <Button Content="Dashboard" Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowDashboardCommand}"/>
                        <Button Content="Test Cases" Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowTestCasesCommand}"/>
                        <Button Content="Test Runs" Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowTestRunsCommand}"/>
                        <Button Content="Bugs" Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowBugsCommand}"/>
                        <Button Content="Requirements" Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowRequirementsCommand}"/>
                        <Button Content="Projects" Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowProjectsCommand}"/>
                        <Button Content="Reports" Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowReportsCommand}"/>
                        <Button Content="Knowledge Base" Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowKnowledgeBaseCommand}"/>
                        <Button Content="Shipment Tracker" Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowShipmentsCommand}"/>
                        <Button Content="RMA Tracker" Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowRmasCommand}"/>
                        <Button Content="CAPAR Tracker" Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowCaparsCommand}"/>
                        <Button Content="Serial Terminal" Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowSerialTerminalCommand}"/>
                        <Button Content="Settings" Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding ShowSettingsCommand}"/>


                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
